# Writes BuildInfo.hh with the git state of the source tree, for benchmark results.
# Runs as a build step (script mode): cmake -DSOURCE_DIR=... -DOUTPUT=... -DCONFIG=... -P BuildInfo.cmake
# The header is only rewritten when its content changes, so an unchanged commit triggers no recompilation.

find_package(Git QUIET)

set(GIT_COMMIT "unknown")
set(GIT_DIRTY "false")
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
        WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE commit RESULT_VARIABLE commit_result
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(commit_result EQUAL 0)
        set(GIT_COMMIT ${commit})

        # Uncommitted changes to tracked files (untracked files do not change the build)
        execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
            WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE status ERROR_QUIET)
        if(NOT status STREQUAL "")
            set(GIT_DIRTY "true")
        endif()
    endif()
endif()

set(content "#pragma once
// Generated by cmake/BuildInfo.cmake at build time; do not edit.

namespace gamedev::build_info
{
inline constexpr char const* git_commit = \"${GIT_COMMIT}\";
inline constexpr bool git_dirty = ${GIT_DIRTY};
inline constexpr char const* config = \"${CONFIG}\";
}
")

file(WRITE ${OUTPUT}.tmp "${content}")
configure_file(${OUTPUT}.tmp ${OUTPUT} COPYONLY)
file(REMOVE ${OUTPUT}.tmp)
